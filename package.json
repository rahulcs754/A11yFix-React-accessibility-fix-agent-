{
  "name": "@rahulcs754/a11yfix",
  "version": "0.1.0",
  "description": "Finds WCAG accessibility errors in React code and fixes them, then opens a PR.",
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "react",
    "nextjs",
    "jsx",
    "eaa",
    "axe",
    "cli",
    "codemod"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rahulcs754/A11yFix-React-accessibility-fix-agent-.git"
  },
  "homepage": "https://github.com/rahulcs754/A11yFix-React-accessibility-fix-agent-#readme",
  "bugs": {
    "url": "https://github.com/rahulcs754/A11yFix-React-accessibility-fix-agent-/issues"
  },
  "author": "rahulcs754",
  "license": "ISC",
  "type": "module",
  "bin": {
    "a11yfix": "dist/cli.js",
    "a11y-fix": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsx src/cli.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p . --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@babel/parser": "^8.0.8",
    "@babel/types": "^8.0.8",
    "axe-core": "^4.14.0",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "playwright": "^1.63.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
