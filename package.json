{
  "name": "a11y-fix-agent",
  "version": "0.1.0",
  "description": "Finds WCAG accessibility errors in React code and fixes them, then opens a PR.",
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsx src/cli.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p . --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@babel/parser": "^8.0.8",
    "@babel/types": "^8.0.8",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "bin": {
    "a11y-fix": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  }
}
